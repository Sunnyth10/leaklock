{
  "name": "leaklock-security",
  "displayName": "LeakLock",
  "description": "Developer-first credential protection. Detect, trace, block, and fix secret leaks before they leave your machine.",
  "version": "1.0.3",
  "publisher": "Sunnyth",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunnyth10/leaklock.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "leaklock",
    "secret",
    "security",
    "git",
    "leak",
    "credentials",
    "api-key",
    "pre-commit"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "leaklock": "./dist/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "leaklock.scanWorkspace",
        "title": "LeakLock: Scan Workspace for Secrets",
        "category": "Security",
        "icon": "$(search)"
      },
      {
        "command": "leaklock.scanStaged",
        "title": "LeakLock: Scan Git Staged Changes",
        "category": "Security",
        "icon": "$(git-commit)"
      },
      {
        "command": "leaklock.openDashboard",
        "title": "LeakLock: Open Security Dashboard",
        "category": "Security",
        "icon": "$(shield)"
      },
      {
        "command": "leaklock.installGitHook",
        "title": "LeakLock: Install Git Pre-Commit Hook",
        "category": "Security",
        "icon": "$(check)"
      },
      {
        "command": "leaklock.uninstallGitHook",
        "title": "LeakLock: Uninstall Git Pre-Commit Hook",
        "category": "Security",
        "icon": "$(trash)"
      },
      {
        "command": "leaklock.ignoreFinding",
        "title": "LeakLock: Ignore Finding as False Positive",
        "category": "Security"
      },
      {
        "command": "leaklock.clearFindings",
        "title": "LeakLock: Clear Findings",
        "category": "Security",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leaklock-sidebar",
          "title": "LeakLock",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "leaklock-sidebar": [
        {
          "id": "leaklock.findingsView",
          "name": "Active Leaks & Findings"
        },
        {
          "id": "leaklock.overviewView",
          "name": "Security Overview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "leaklock.scanWorkspace",
          "when": "view == leaklock.findingsView",
          "group": "navigation@1"
        },
        {
          "command": "leaklock.openDashboard",
          "when": "view == leaklock.findingsView",
          "group": "navigation@2"
        },
        {
          "command": "leaklock.clearFindings",
          "when": "view == leaklock.findingsView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "LeakLock",
      "properties": {
        "leaklock.enableRealtimeScanning": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan open documents on save or change."
        },
        "leaklock.blockGitCommits": {
          "type": "boolean",
          "default": true,
          "description": "Intercept commits and block them if unredacted credentials are staged."
        },
        "leaklock.minEntropy": {
          "type": "number",
          "default": 3.4,
          "description": "Minimum Shannon entropy threshold for generic secret detection."
        },
        "leaklock.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask credential values in the UI and terminal to avoid secondary leaks."
        },
        "leaklock.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/*.min.js",
            "**/*.lock",
            "**/package-lock.json",
            "**/pnpm-lock.yaml"
          ],
          "description": "File patterns excluded from workspace secret scans."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "build:web": "vite build",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "lint": "tsc --noEmit",
    "cli": "node dist/cli.js",
    "dev": "vite",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "node esbuild.js --test && node dist/test-suite.js",
    "package": "vsce package --no-git-tag-version --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "@vitejs/plugin-react": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "oxfmt": "^0.2.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}